    <path d="M16 16L6.5 8.5M16 16L25.5 7M16 16L26 23.5M16 16L8 25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
    <g fill="currentColor" opacity="0.85">
        <circle cx="6.5" cy="8.5" r="2.3"/>
        <circle cx="25.5" cy="7" r="2.3"/>
        <circle cx="26" cy="23.5" r="2.3"/>
        <circle cx="8" cy="25" r="2.3"/>
    </g>
    <circle cx="16" cy="16" r="4.8" fill="currentColor"/>
</svg>
